{
  "name": "velaarturo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:staging",
    "build:staging": "pnpm typecheck && CLOUDFLARE_ENV=staging vite build",
    "build:production": "pnpm typecheck && CLOUDFLARE_ENV=production vite build",
    "preview": "pnpm build:staging && vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "comments:migrate:neon": "node scripts/migrate-neon-comments.mjs",
    "deploy:dry": "pnpm build:staging && wrangler deploy --dry-run",
    "deploy:staging": "pnpm build:staging && pnpm db:migrate:staging && wrangler deploy",
    "deploy:production": "pnpm build:production && pnpm db:migrate:production && wrangler deploy"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@formspree/react": "^3.0.0",
    "@marsidev/react-turnstile": "^1.4.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
